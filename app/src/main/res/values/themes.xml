<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Dark only: a car cabin at night, and Google's automotive guidance starts from black. -->
    <style name="Theme.DwellPlay" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">@color/canvas</item>
        <item name="android:colorBackground">@color/canvas</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <!-- Cars have odd cutouts; Google asks for ALWAYS or NEVER, not the phone defaults. -->
        <item name="android:windowLayoutInDisplayCutoutMode">always</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
